<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TidyDesk.Mac.App"
             Name="TidyDesk"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <!-- Filled in code with "About TidyDesk" (App.RefreshMenu); macOS adds Hide and Quit -->
    <NativeMenu.Menu>
        <NativeMenu />
    </NativeMenu.Menu>
</Application>
