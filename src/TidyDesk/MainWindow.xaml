<Window x:Class="TidyDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TidyDesk"
        Title="{DynamicResource s.appTitle}" Width="720" Height="720" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Brand colors: match the logo, identical in light and dark themes -->
        <SolidColorBrush x:Key="Brand" Color="#2B84EA" />
        <SolidColorBrush x:Key="BrandSoft" Color="#262B84EA" />
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#45A0F5" Offset="0" />
            <GradientStop Color="#1D68D8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4ADE9B" Offset="0" />
            <GradientStop Color="#16A34A" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Primary action: gradient pill button with a soft glow -->
        <Style x:Key="PrimaryPill" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="27" Background="{StaticResource BrandGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1D68D8" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Shine" CornerRadius="27" Background="White" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="27" BorderBrush="White" BorderThickness="2" Margin="3" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glow" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                <Setter TargetName="Glow" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action: outlined pill button -->
        <Style x:Key="GhostPill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="22" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="22" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="22" BorderBrush="{StaticResource Brand}" BorderThickness="2" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language switch button (TR | EN) -->
        <Style x:Key="LangButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Padding="11,4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brand}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder card: brand-colored ring and check badge when selected -->
        <Style x:Key="FolderCard" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="18" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="18" BorderBrush="{StaticResource Brand}" BorderThickness="2" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrandGradient}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Border.RenderTransform>
                                <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE73E;" Foreground="White" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.5" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.5" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.04" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder card content -->
        <DataTemplate DataType="{x:Type local:FolderItem}">
            <Grid Width="136" Height="148" Margin="6">
                <ToggleButton Style="{StaticResource FolderCard}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsAllowed}"
                              Click="Folder_Toggled" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel>
                        <Border x:Name="IconTile" Width="52" Height="52" CornerRadius="16" Background="{StaticResource BrandSoft}">
                            <TextBlock x:Name="IconGlyph" Style="{StaticResource Glyph}" FontSize="24" Text="{Binding Glyph}" Foreground="{StaticResource Brand}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="116" />
                        <TextBlock Text="{Binding Badge}" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Width="22" Height="22" Padding="0"
                        Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="RemoveFolder_Click" Cursor="Hand"
                        ToolTip="{DynamicResource s.removeFolder}" AutomationProperties.Name="{DynamicResource s.removeFolder}"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="&#xE711;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="IconTile" Property="Background" Value="{StaticResource BrandGradient}" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="White" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "Add folder" card: dashed outline -->
        <DataTemplate DataType="{x:Type local:AddFolderTile}">
            <Button Width="136" Height="148" Margin="6" Click="AddFolder_Click" Cursor="Hand"
                    ToolTip="{DynamicResource s.addFolderTip}" AutomationProperties.Name="{DynamicResource s.addFolderTip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Dash" RadiusX="18" RadiusY="18" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <TextBlock x:Name="Plus" Style="{StaticResource Glyph}" FontSize="20" Text="&#xE710;"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="{DynamicResource s.addFolder}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text=" " FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brand}" />
                                <Setter TargetName="Plus" Property="Foreground" Value="{StaticResource Brand}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Main screen ================= -->
        <!-- Viewbox: content scales down in small windows instead of showing a scrollbar -->
        <Viewbox x:Name="HomeView" StretchDirection="DownOnly" Margin="0,0,0,4">
            <StackPanel Margin="32,24" Width="620">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <Grid Width="200" Height="120" HorizontalAlignment="Center">
                    <Ellipse Width="200" Height="120" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#552B84EA" Offset="0" />
                                <GradientStop Color="#002B84EA" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="68" Height="68" />
                </Grid>
                <TextBlock Style="{StaticResource Title}" Margin="0,2,0,0" Text="{DynamicResource s.homeTitle}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="15" Margin="0,8,0,0"
                           Text="{DynamicResource s.homeSubtitle}" />

                <ItemsControl x:Name="FolderTiles" Margin="0,30,0,0" HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="FolderError" Style="{StaticResource Secondary}" Margin="0,10,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                <Button x:Name="OrganizeButton" Style="{StaticResource PrimaryPill}" Width="340" HorizontalAlignment="Center"
                        Margin="0,34,0,0" Click="Organize_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OrganizeGlyph" Style="{StaticResource Glyph}" FontSize="17" Text="&#xE945;" />
                        <TextBlock x:Name="OrganizeText" Text="Scanning folders…" Margin="10,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="200" Height="3" Margin="0,12,0,0" Visibility="Hidden" />
                <TextBlock x:Name="HomeHint" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{DynamicResource s.homeHint}" />
                <TextBlock x:Name="HomeMessage" Style="{StaticResource Secondary}" FontSize="13" Margin="0,16,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="UndoLastLink" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12" Visibility="Collapsed">
                    <Hyperlink Click="UndoLast_Click" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run x:Name="UndoLastText" Text="Undo last cleanup" /></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Viewbox>

        <!-- ================= Done screen ================= -->
        <Viewbox x:Name="DoneView" StretchDirection="DownOnly" Margin="0,0,0,4" Visibility="Collapsed">
            <StackPanel Margin="32,24" Width="560">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <!-- Check mark: circle pops in, ring spreads, check is drawn, confetti bursts -->
                <Grid Width="240" Height="200" HorizontalAlignment="Center">
                    <Canvas x:Name="Burst" Width="240" Height="200" IsHitTestVisible="False" />
                    <Ellipse x:Name="PulseRing" Width="116" Height="116" Stroke="#4ADE9B" StrokeThickness="3" Opacity="0"
                             RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="CheckCircle" Width="116" Height="116" Fill="{StaticResource SuccessGradient}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0" ScaleY="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#16A34A" BlurRadius="36" ShadowDepth="0" Opacity="0.5" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Path x:Name="CheckMark" Width="116" Height="116" Stroke="White" StrokeThickness="9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          StrokeDashArray="8 8" StrokeDashOffset="8"
                          Data="M 36,60 L 52,76 L 82,44" />
                </Grid>

                <TextBlock x:Name="DoneTitle" Style="{StaticResource Title}" Margin="0,2,0,0" Text="16 files tidied up" />
                <TextBlock x:Name="DoneSubtitle" Style="{StaticResource Secondary}" FontSize="15" Margin="0,8,0,0" />

                <ItemsControl x:Name="DoneChips" Margin="0,22,0,0" HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChipItem}">
                            <Border Background="{Binding Tint}" CornerRadius="15" Padding="12,6" Margin="4" Opacity="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{Binding Glyph}" Foreground="{Binding Accent}" />
                                    <TextBlock Text="{Binding Text}" Margin="7,0,0,0" Foreground="{Binding Accent}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="DoneNote" Style="{StaticResource Secondary}" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />

                <Button x:Name="OpenButton" Style="{StaticResource PrimaryPill}" Width="340" HorizontalAlignment="Center"
                        Margin="0,32,0,0" Click="OpenTargets_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="17" Text="&#xE838;" />
                        <TextBlock Text="{DynamicResource done.open}" Margin="10,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="UndoButton" Style="{StaticResource GhostPill}" Width="164" Margin="0,0,12,0" Click="Undo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE7A7;" />
                            <TextBlock Text="{DynamicResource done.undo}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostPill}" Width="164" Content="{DynamicResource done.ok}" Click="Back_Click" />
                </StackPanel>
            </StackPanel>
        </Viewbox>

        <!-- Language switch -->
        <Border x:Name="LangSwitch" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0" CornerRadius="14" Padding="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LangTr" Style="{StaticResource LangButton}" Content="TR" Tag="tr" Click="Language_Click" AutomationProperties.Name="Türkçe" ToolTip="Türkçe" />
                <Button x:Name="LangEn" Style="{StaticResource LangButton}" Content="EN" Tag="en" Click="Language_Click" AutomationProperties.Name="English" ToolTip="English" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="1" Margin="16,0,16,14" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.8"
                   Text="{DynamicResource s.footer}" />
    </Grid>
</Window>
