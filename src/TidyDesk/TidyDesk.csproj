<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The WPF Fluent theme (ThemeMode) is still marked experimental in .NET -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>TidyDesk</AssemblyTitle>
    <Product>TidyDesk</Product>
    <Company>odmcc</Company>
    <Copyright>Copyright (c) 2026 odmcc. MIT License.</Copyright>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TidyDesk.Core\TidyDesk.Core.csproj" />
  </ItemGroup>

</Project>
